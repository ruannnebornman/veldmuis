#!/usr/bin/env bash

set -euo pipefail

graphics_conf_path="${VELDMUIS_CALAMARES_GRAPHICS_CONF_PATH:-/etc/calamares/modules/graphics.conf}"
graphics_template_path="${VELDMUIS_CALAMARES_GRAPHICS_TEMPLATE_PATH:-/usr/share/veldmuis/calamares/graphics.conf}"
skip_exec="${VELDMUIS_CALAMARES_SKIP_EXEC:-0}"
calamares_log_path="${VELDMUIS_CALAMARES_LOG_PATH:-/tmp/veldmuis-calamares-debug.log}"
bootstrap_log_path="${VELDMUIS_CALAMARES_BOOTSTRAP_LOG_PATH:-/tmp/veldmuis-calamares-bootstrap.log}"

detect_graphics() {
  if ! command -v lspci >/dev/null 2>&1; then
    return 0
  fi

  lspci -nn 2>/dev/null | grep -Ei 'VGA compatible controller|3D controller|Display controller' || true
}

render_graphics_conf() {
  local default_id="$1"
  local template_path="${graphics_template_path}"
  local tmp_graphics_conf
  shift

  [[ -r "${template_path}" ]] || template_path="${graphics_conf_path}"
  [[ -r "${template_path}" ]] || {
    printf 'Graphics config template is not readable: %s\n' "${graphics_template_path}" >&2
    return 1
  }

  tmp_graphics_conf="$(mktemp -t veldmuis-graphics-conf.XXXXXX)"

  awk -v default_id="${default_id}" -v selected_ids="$*" '
    BEGIN {
      split(selected_ids, ids, " ")
      for (idx in ids) {
        selected[ids[idx]] = 1
      }
      in_items = 0
      emit_item = 1
    }

    !in_items {
      if ($0 ~ /^default:/) {
        print "default: " default_id
        next
      }

      print

      if ($0 ~ /^items:[[:space:]]*$/) {
        in_items = 1
      }

      next
    }

    /^  - id:[[:space:]]*/ {
      id = $0
      sub(/^  - id:[[:space:]]*/, "", id)
      sub(/[[:space:]]*$/, "", id)
      emit_item = (id in selected)
    }

    emit_item {
      print
    }
  ' "${template_path}" >"${tmp_graphics_conf}"

  install -Dm644 "${tmp_graphics_conf}" "${graphics_conf_path}"
  rm -f "${tmp_graphics_conf}"
}

prepare_logs() {
  rm -f "${calamares_log_path}" "${bootstrap_log_path}"
  touch "${calamares_log_path}"
}

main() {
  local graphics_lines
  local has_amd=0
  local has_intel=0
  local has_nvidia=0
  local -a selected_graphics_ids=(all-open-source)

  graphics_lines="$(detect_graphics)"

  if grep -qiE 'AMD/ATI|Advanced Micro Devices|AMD\b|ATI\b' <<<"${graphics_lines}"; then
    has_amd=1
  fi

  if grep -qi 'Intel' <<<"${graphics_lines}"; then
    has_intel=1
  fi

  if grep -qi 'NVIDIA' <<<"${graphics_lines}"; then
    has_nvidia=1
  fi

  if (( has_amd )); then
    selected_graphics_ids+=(amd-open-source)
  fi

  if (( has_intel )); then
    selected_graphics_ids+=(intel-open-source)
  fi

  if (( has_nvidia )); then
    selected_graphics_ids+=(nvidia-open-source nvidia-580xx-dkms)
  fi

  render_graphics_conf all-open-source "${selected_graphics_ids[@]}"

  prepare_logs

  exec > >(tee "${calamares_log_path}") 2>&1

  if [[ "${skip_exec}" == "1" ]]; then
    exit 0
  fi

  exec /usr/bin/calamares -d
}

main "$@"
