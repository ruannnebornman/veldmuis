#!/usr/bin/env bash

set -euo pipefail

hosts_alias="syncthing.localhost"
hosts_line="127.0.0.1 ${hosts_alias}"
ui_url="http://${hosts_alias}:8384/"
assume_yes=0
configure_hosts=0
configure_service=0

log() {
  printf '[veldmuis-syncthing-setup] %s\n' "$*"
}

die() {
  printf '[veldmuis-syncthing-setup] ERROR: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<EOF
Usage:
  veldmuis-syncthing-setup --hosts
  veldmuis-syncthing-setup --service
  veldmuis-syncthing-setup --all

Options:
  --hosts     Add ${hosts_alias} to /etc/hosts.
  --service   Enable and start the Syncthing user service for this user.
  --all       Configure both the hosts alias and user service.
  --yes       Do not prompt before making requested changes.
  -h, --help  Show this help.

Web UI:
  ${ui_url}
EOF
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "Missing required command: $1"
}

confirm() {
  local prompt="$1"
  local answer=""

  ((assume_yes == 1)) && return 0

  printf '%s [y/N] ' "${prompt}" >&2
  IFS= read -r answer || answer=""
  [[ "${answer}" == "y" || "${answer}" == "Y" || "${answer}" == "yes" || "${answer}" == "YES" ]]
}

hosts_alias_present() {
  awk -v alias="${hosts_alias}" '
    $1 == "127.0.0.1" {
      for (idx = 2; idx <= NF; idx++) {
        if ($idx == alias) {
          found = 1
          exit
        }
      }
    }
    END { exit found ? 0 : 1 }
  ' /etc/hosts
}

append_hosts_line() {
  if ((EUID == 0)); then
    printf '\n%s\n' "${hosts_line}" >> /etc/hosts
    return
  fi

  require_cmd sudo
  printf '\n%s\n' "${hosts_line}" | sudo tee -a /etc/hosts >/dev/null
}

configure_hosts_alias() {
  [[ -r /etc/hosts ]] || die "/etc/hosts is not readable."

  if hosts_alias_present; then
    log "${hosts_alias} is already present in /etc/hosts"
    return
  fi

  confirm "Add '${hosts_line}' to /etc/hosts?" || {
    log "Skipped hosts alias setup"
    return
  }

  append_hosts_line
  log "Added ${hosts_alias} to /etc/hosts"
}

configure_user_service() {
  ((EUID != 0)) || die "Run --service as the target desktop user, not as root."

  require_cmd systemctl
  require_cmd syncthing

  confirm "Enable and start syncthing.service for the current user?" || {
    log "Skipped Syncthing user service setup"
    return
  }

  systemctl --user reset-failed syncthing.service 2>/dev/null || true
  systemctl --user enable --now syncthing.service
  log "Syncthing user service is enabled and started"
}

main() {
  while (($# > 0)); do
    case "$1" in
      --hosts)
        configure_hosts=1
        ;;
      --service)
        configure_service=1
        ;;
      --all)
        configure_hosts=1
        configure_service=1
        ;;
      --yes)
        assume_yes=1
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        usage >&2
        die "Unsupported argument: $1"
        ;;
    esac
    shift
  done

  if ((configure_hosts == 0 && configure_service == 0)); then
    usage
    exit 0
  fi

  if ((configure_hosts == 1)); then
    configure_hosts_alias
  fi

  if ((configure_service == 1)); then
    configure_user_service
  fi

  log "Syncthing web UI: ${ui_url}"
}

main "$@"
