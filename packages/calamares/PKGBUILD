pkgname=calamares
pkgver=3.3.14
pkgrel=2
pkgdesc="Distribution-independent installer framework"
arch=("x86_64")
url="https://calamares.io/"
license=("GPL-3.0-or-later")
options=("!debug")
depends=(
  "boost-libs"
  "hwinfo"
  "kcoreaddons"
  "kcrash"
  "kdbusaddons"
  "kglobalaccel"
  "kirigami"
  "kpmcore"
  "libpwquality"
  "polkit-qt6"
  "qt6-declarative"
  "qt6-svg"
  "qt6-tools"
  "qt6-translations"
  "yaml-cpp"
)
makedepends=(
  "boost"
  "cmake"
  "extra-cmake-modules"
  "kpmcore"
  "python"
)
source=(
  "https://github.com/calamares/calamares/releases/download/v${pkgver}/calamares-${pkgver}.tar.gz"
  "0001-limit-partition-filesystems.patch"
  "0002-users-hostname-and-password-ux.patch"
  "0003-skip-invalid-vconsole-keymaps.patch"
)
sha256sums=(
  "5547f80db067dea923ae693ba6bb88eb2b2eeac1da3ebec42fce453e31c290c0"
  "a7e49e26992baf9e37526c08e17999f4b80d18e1a394cbe500d468b49d38b37b"
  "6e3cf2825f1b20fb47af100c912116cc08ba521640aea66a46a7ee230f04bc07"
  "729be212df0a1ba55dcd8ca8845879241d69a51d86c15bc4f80d5954e65d03cd"
)
prepare() {
  cd "calamares-${pkgver}"

  if ! grep -q 'selectableFilesystemTypes' src/modules/partition/gui/PartitionDialogHelpers.h; then
    patch -Np1 -i "${srcdir}/0001-limit-partition-filesystems.patch"
  fi

  if ! grep -q '<< "hostname"' src/modules/users/Config.cpp; then
    patch -Np1 -i "${srcdir}/0002-users-hostname-and-password-ux.patch"
  fi

  if ! grep -q 'No vconsole keymap mapping for X11 layout' src/modules/keyboard/SetKeyboardLayoutJob.cpp; then
    patch -Np1 -i "${srcdir}/0003-skip-invalid-vconsole-keymaps.patch"
  fi
}

build() {
  cmake -B build -S "calamares-${pkgver}" \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DBUILD_TESTING=OFF \
    -DINSTALL_CONFIG=ON \
    -DWITH_QT6=ON \
    -DKDE_INSTALL_USE_QT_SYS_PATHS=ON

  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
}
