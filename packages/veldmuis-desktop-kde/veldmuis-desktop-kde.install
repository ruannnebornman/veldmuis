_veldmuis_enable_power_profile() {
  command -v systemctl >/dev/null 2>&1 || return 0

  systemctl disable cpu-max-performance.service >/dev/null 2>&1 || true

  if systemctl enable veldmuis-power-profile.service >/dev/null 2>&1; then
    return 0
  fi

  printf '%s\n' \
    "Could not enable veldmuis-power-profile.service automatically; enable it before rebooting."
}

post_install() {
  _veldmuis_enable_power_profile
}

post_upgrade() {
  _veldmuis_enable_power_profile
}
