[Unit]
Description=Force CPU max performance (governor+EPP, PPD performance)
After=power-profiles-daemon.service multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'powerprofilesctl set performance || true; echo performance | tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; echo performance | tee /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference'

[Install]
WantedBy=multi-user.target
