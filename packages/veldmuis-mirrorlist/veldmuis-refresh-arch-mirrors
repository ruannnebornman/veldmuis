#!/usr/bin/env bash

set -euo pipefail

output_path="/etc/pacman.d/mirrorlist"
backup_dir="/etc/pacman.d/veldmuis-mirrorlist-backups"
keep_backups=5
max_mirrors="${VELDMUIS_REFLECTOR_MAX_MIRRORS:-10}"
backup_enabled=1

log() {
  printf '[veldmuis-refresh-arch-mirrors] %s\n' "$*"
}

die() {
  printf '[veldmuis-refresh-arch-mirrors] ERROR: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  veldmuis-refresh-arch-mirrors [--output PATH] [--no-backup]

Options:
  --output PATH  Write the ranked Arch mirrorlist to PATH.
  --no-backup    Do not back up the existing output file.
  -h, --help     Show this help.
EOF
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "Missing required command: $1"
}

has_active_servers() {
  awk '
    /^[[:space:]]*Server[[:space:]]*=/ {
      found = 1
      exit
    }
    END { exit found ? 0 : 1 }
  ' "$1"
}

country_from_locale_value() {
  local locale_value="$1"
  local country=""

  [[ "${locale_value}" =~ _([A-Za-z]{2})([.@]|$) ]] || return 1
  country="${BASH_REMATCH[1]}"
  printf '%s\n' "${country}" | tr '[:lower:]' '[:upper:]'
}

detect_locale_country() {
  local locale_value=""

  if [[ -n "${LANG:-}" ]] && country_from_locale_value "${LANG}"; then
    return 0
  fi

  if [[ -f /etc/locale.conf ]]; then
    locale_value="$(awk -F= '$1 == "LANG" { gsub(/"/, "", $2); print $2; exit }' /etc/locale.conf)"
    if [[ -n "${locale_value}" ]] && country_from_locale_value "${locale_value}"; then
      return 0
    fi
  fi

  return 1
}

detect_timezone() {
  local localtime_target=""
  local timezone=""

  if localtime_target="$(readlink -f /etc/localtime 2>/dev/null)"; then
    case "${localtime_target}" in
      /usr/share/zoneinfo/*)
        printf '%s\n' "${localtime_target#/usr/share/zoneinfo/}"
        return 0
        ;;
    esac
  fi

  if command -v timedatectl >/dev/null 2>&1; then
    timezone="$(timedatectl show --property=Timezone --value 2>/dev/null | awk 'NF { print; exit }')"
    [[ -n "${timezone}" ]] || return 1
    printf '%s\n' "${timezone}"
    return 0
  fi

  return 1
}

detect_timezone_country() {
  local timezone=""
  local zone_tab="/usr/share/zoneinfo/zone1970.tab"

  [[ -f "${zone_tab}" ]] || return 1
  timezone="$(detect_timezone)"
  [[ -n "${timezone}" ]] || return 1

  awk -v timezone="${timezone}" '
    $0 !~ /^#/ && $3 == timezone {
      split($1, countries, ",")
      print countries[1]
      found = 1
      exit
    }
    END { exit found ? 0 : 1 }
  ' "${zone_tab}"
}

detect_country_filter() {
  if [[ -n "${VELDMUIS_REFLECTOR_COUNTRIES:-}" ]]; then
    printf '%s\n' "${VELDMUIS_REFLECTOR_COUNTRIES}"
    return 0
  fi

  detect_locale_country && return 0
  detect_timezone_country && return 0

  return 1
}

run_reflector() {
  local output="$1"
  shift

  reflector "$@" --save "${output}" || return 1
  has_active_servers "${output}"
}

write_combined_mirrorlist() {
  local output="$1"
  local country_filter="$2"
  shift 2

  {
    cat <<EOF
################################################################################
############ Arch Linux mirrorlist generated by Veldmuis reflector #############
################################################################################

# When: $(date -u +%Y-%m-%dT%H:%M:%SZ)
# Country filter: ${country_filter:-none}
# Local policy: reflector --protocol https --age 12 --delay 2 --country COUNTRY --sort rate --threads 5 --number 5
# Global fallback: reflector --protocol https --age 6 --delay 2 --score 20 --sort rate --threads 5 --number 10

EOF

    awk -v max_mirrors="${max_mirrors}" '
      /^[[:space:]]*Server[[:space:]]*=/ {
        sub(/^[[:space:]]*/, "")
        if (!seen[$0]++) {
          print
          count++
          if (count >= max_mirrors) {
            exit
          }
        }
      }
    ' "$@"
  } > "${output}"
}

backup_existing_mirrorlist() {
  local backup_path=""
  local timestamp=""

  ((backup_enabled == 1)) || return 0
  [[ -f "${output_path}" ]] || return 0

  install -d -m755 "${backup_dir}"
  timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
  backup_path="${backup_dir}/mirrorlist.${timestamp}"
  cp -p "${output_path}" "${backup_path}"

  find "${backup_dir}" -maxdepth 1 -type f -name 'mirrorlist.*' \
    -printf '%T@ %p\n' \
    | sort -rn \
    | awk -v keep="${keep_backups}" 'NR > keep { $1=""; sub(/^ /, ""); print }' \
    | while IFS= read -r old_backup; do
        [[ -n "${old_backup}" ]] || continue
        rm -f -- "${old_backup}"
      done
}

write_ranked_mirrorlist() {
  local country_filter=""
  local country_output=""
  local global_output=""
  local -a mirrorlist_sources=()
  local output_dir=""
  local output_name=""
  local tmp_output=""

  output_dir="$(dirname -- "${output_path}")"
  output_name="$(basename -- "${output_path}")"
  [[ -d "${output_dir}" ]] || install -d -m755 "${output_dir}"
  tmp_output="$(mktemp -p "${output_dir}" ".${output_name}.veldmuis.XXXXXX")"
  country_output="$(mktemp -p "${output_dir}" ".${output_name}.country.XXXXXX")"
  global_output="$(mktemp -p "${output_dir}" ".${output_name}.global.XXXXXX")"

  if country_filter="$(detect_country_filter)"; then
    log "Ranking Arch mirrors for country filter: ${country_filter}"
    if run_reflector "${country_output}" \
      --protocol https \
      --age 12 \
      --delay 2 \
      --country "${country_filter}" \
      --sort rate \
      --threads 5 \
      --number 5
    then
      mirrorlist_sources+=("${country_output}")
    else
      log "Country mirror ranking failed; continuing with global mirrors"
    fi
  fi

  if run_reflector "${global_output}" \
    --protocol https \
    --age 6 \
    --delay 2 \
    --score 20 \
    --sort rate \
    --threads 5 \
    --number 10
  then
    mirrorlist_sources+=("${global_output}")
  else
    log "Global mirror ranking failed"
  fi

  if ((${#mirrorlist_sources[@]} == 0)); then
    rm -f -- "${tmp_output}" "${country_output}" "${global_output}"
    die "Reflector failed to generate a ranked Arch mirrorlist."
  fi

  write_combined_mirrorlist "${tmp_output}" "${country_filter}" "${mirrorlist_sources[@]}"

  if ! has_active_servers "${tmp_output}"; then
    rm -f -- "${tmp_output}" "${country_output}" "${global_output}"
    die "Reflector did not produce an active Arch mirrorlist."
  fi

  backup_existing_mirrorlist
  install -m644 "${tmp_output}" "${output_path}"
  rm -f -- "${tmp_output}" "${country_output}" "${global_output}"
  log "Updated Arch mirrorlist at ${output_path}"
}

main() {
  case "${max_mirrors}" in
    ""|*[!0-9]*)
      max_mirrors=10
      ;;
  esac

  while (($# > 0)); do
    case "$1" in
      --output)
        shift
        [[ $# -gt 0 ]] || die "--output requires a path."
        output_path="$1"
        ;;
      --no-backup)
        backup_enabled=0
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        usage >&2
        die "Unsupported argument: $1"
        ;;
    esac
    shift
  done

  if [[ "${output_path}" != "/etc/pacman.d/mirrorlist" ]]; then
    backup_enabled=0
  fi

  require_cmd reflector
  write_ranked_mirrorlist
}

main "$@"
