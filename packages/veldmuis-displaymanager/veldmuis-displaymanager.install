_veldmuis_legacy_greetd_config="/etc/greetd/config.toml"
_veldmuis_legacy_greetd_hashes="c90785ff8783e68dc9e0d4c9c48461a93d6a781e17da857c02ec8905d80e1b46 b22a211900b08d9d208d88a8ebfd1c93bbc59c58ebb2c98dc8ea6a5f0e57e3c3 5bd343f444f2cfa8a1cbcdb54038c4887b0156a6f8bf1c39412233e0dca40593"

_veldmuis_remove_legacy_config() {
  local current_hash=""

  if [ -f "${_veldmuis_legacy_greetd_config}" ]; then
    current_hash="$(sha256sum "${_veldmuis_legacy_greetd_config}" | awk '{print $1}')"
    case " ${_veldmuis_legacy_greetd_hashes} " in
      *" ${current_hash} "*)
        rm -f "${_veldmuis_legacy_greetd_config}"
        ;;
    esac
  fi

  rm -f "${_veldmuis_legacy_greetd_config}.veldmuis"
  rmdir /etc/greetd 2>/dev/null || true
}

_veldmuis_enable_plasma_login() {
  command -v systemctl >/dev/null 2>&1 || return 0

  for legacy_unit in greetd.service sddm.service; do
    systemctl disable "${legacy_unit}" >/dev/null 2>&1 || true
  done

  if systemctl enable --force plasmalogin.service >/dev/null 2>&1; then
    return 0
  fi

  printf '%s\n' \
    "Could not enable plasmalogin.service automatically; enable it before rebooting."
}

_veldmuis_configure_display_manager() {
  _veldmuis_remove_legacy_config
  _veldmuis_enable_plasma_login
}

post_install() {
  _veldmuis_configure_display_manager
}

post_upgrade() {
  _veldmuis_configure_display_manager
}
