verify() {
  cd "${_source_root}"
  printf '%s\n' "${_payload_sha256sums[@]}" | sha256sum --check --quiet
}

package() {
  local module

  install -Dm644 "${srcdir}/settings.conf" \
    "${pkgdir}/etc/calamares/settings.conf"

  for module in \
    bootloader \
    finished \
    gaming \
    graphics \
    initcpiocfg \
    locale \
    packages \
    partition \
    services-systemd \
    users \
    veldmuis-boot-finalize \
    veldmuis-bootstrap \
    welcome
  do
    install -Dm644 "${_source_root}/modules/${module}.conf" \
      "${pkgdir}/etc/calamares/modules/${module}.conf"
  done

  install -Dm755 "${srcdir}/veldmuis-calamares-bootstrap.sh" \
    "${pkgdir}/usr/lib/veldmuis/veldmuis-calamares-bootstrap.sh"

  install -Dm644 "${_source_root}/branding/veldmuis/branding.desc" \
    "${pkgdir}/etc/calamares/branding/veldmuis/branding.desc"
  install -Dm644 "${_source_root}/branding/veldmuis/stylesheet.qss" \
    "${pkgdir}/etc/calamares/branding/veldmuis/stylesheet.qss"
  install -Dm644 "${_source_root}/branding/veldmuis/show.qml" \
    "${pkgdir}/etc/calamares/branding/veldmuis/show.qml"
  install -Dm644 "${_branding_root}/rat1.png" \
    "${pkgdir}/etc/calamares/branding/veldmuis/rat1.png"
  install -Dm644 "${_source_root}/branding/veldmuis/logomain.png" \
    "${pkgdir}/etc/calamares/branding/veldmuis/logomain.png"
}
