pkgname=veldmuis-calamares-config
pkgver=20260308
pkgrel=36
pkgdesc="Veldmuis Calamares configuration and bootstrap scripts"
arch=("any")
url="https://github.com/ruannnebornman/veldmuis"
license=("MIT" "CC-BY-SA")
depends=(
  "arch-install-scripts"
  "bash"
  "calamares"
  "reflector"
)
_source_root="${PWD}"
_branding_root="${_source_root}/../veldmuis-branding"
source=(
  "settings.conf"
  "veldmuis-calamares-bootstrap.sh"
)
sha256sums=(
  "a6f1682855d6983f764a7eb3b237b11b59016f93e1d2c7845b821a7d4fe2e281"
  "3fb2a9f60b522f9556d48bf4ab7818385a7f5f8dce54442cad88576cbe3cb55b"
)
_payload_sha256sums=(
