license=("MIT")
depends=(
  "filesystem"
  "veldmuis-keyring"
  "veldmuis-lsb-release"
  "veldmuis-mirrorlist"
)
source=("veldmuis-release" "veldmuis.conf" "os-release")
sha256sums=(
  "57b863d77a852edf14e376124c732f9d31125ab3da604e9a06a508a2e07d51f6"
  "7534a0941f15e2d351b6cb570d5ec5d327689375cc6be2714aa67cc45a57adff"
  "7746200f07620bb88a67cb4083527dc86a64d51b459f7a1786cce1caf69c5c08"
)

package() {
  install -Dm644 veldmuis-release "$pkgdir/etc/veldmuis-release"
  install -Dm644 veldmuis.conf "$pkgdir/etc/pacman.conf.d/veldmuis.conf"
  install -Dm644 os-release "$pkgdir/etc/os-release"
}
