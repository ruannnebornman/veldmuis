pkgname=veldmuis-boot
pkgver=20260305
pkgrel=5
pkgdesc="UEFI boot policy metapackage for Veldmuis Linux"
arch=("any")
url="https://github.com/ruannnebornman/veldmuis"
license=("MIT")
install="${pkgname}.install"
depends=(
  "veldmuis-base"
  "systemd"
  "efibootmgr"
)
source=(
  "95-veldmuis-kernel-install-sync.hook"
  "veldmuis-kernel-install-sync"
  "${pkgname}.install"
)
sha256sums=(
  "SKIP"
  "SKIP"
  "SKIP"
)

package() {
  install -Dm644 "${srcdir}/95-veldmuis-kernel-install-sync.hook" \
    "${pkgdir}/usr/share/libalpm/hooks/95-veldmuis-kernel-install-sync.hook"
  install -Dm755 "${srcdir}/veldmuis-kernel-install-sync" \
    "${pkgdir}/usr/lib/veldmuis/veldmuis-kernel-install-sync"
}
