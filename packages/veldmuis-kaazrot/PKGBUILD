package() {
  local templates_root="${pkgdir}/usr/share/veldmuis-kaazrot/templates"

  install -Dm755 "${srcdir}/veldmuis-kaazrot-apply" \
    "${pkgdir}/usr/bin/veldmuis-kaazrot-apply"
  install -Dm644 "${srcdir}/veldmuis-kaazrot-apply.service" \
    "${pkgdir}/usr/lib/systemd/user/veldmuis-kaazrot-apply.service"
  install -d "${pkgdir}/etc/systemd/user/default.target.wants"
  ln -s /usr/lib/systemd/user/veldmuis-kaazrot-apply.service \
    "${pkgdir}/etc/systemd/user/default.target.wants/veldmuis-kaazrot-apply.service"
  install -Dm644 "${srcdir}/fish-config.fish" \
    "${templates_root}/fish/config.fish"
  install -Dm644 "${srcdir}/wezterm.lua" \
    "${templates_root}/wezterm/wezterm.lua"
  install -Dm644 "${srcdir}/opencode-AGENTS.md" \
    "${templates_root}/opencode/AGENTS.md"
  install -Dm644 "${srcdir}/opencode-opencode.jsonc" \
    "${templates_root}/opencode/opencode.jsonc"
  install -Dm644 "${srcdir}/opencode-tui.jsonc" \
    "${templates_root}/opencode/tui.jsonc"
  install -Dm644 "${srcdir}/opencode-ctrl-c-interrupt.mjs" \
    "${templates_root}/opencode/opencode-ctrl-c-interrupt.mjs"
  install -Dm644 "${srcdir}/opencode-wezterm-attention.mjs" \
    "${templates_root}/opencode/opencode-wezterm-attention.mjs"
  install -Dm644 "${srcdir}/opencode-wezterm-sessions.mjs" \
    "${templates_root}/opencode/opencode-wezterm-sessions.mjs"
}
