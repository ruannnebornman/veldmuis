{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "file:///home/kaazrot/.config/opencode/opencode-wezterm-attention.mjs",
    "file:///home/kaazrot/.config/opencode/opencode-wezterm-sessions.mjs"
  ],
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "lfm-heretic": {
          "name": "LFM2.5 Heretic",
          "limit": {
            "context": 32768,
            "output": 4096
          }
        }
      }
    }
  },
  "experimental": {
    "policies": [
      {
        "effect": "deny",
        "action": "provider.use",
        "resource": "openai"
      }
    ]
  },
  "lsp": true,
  "permission": "allow"
}
