pkgname=veldmuis-nvidia-legacy
pkgver=20260619
pkgrel=4
pkgdesc="Legacy NVIDIA 580xx support metapackage for Veldmuis Linux"
arch=("any")
url="https://github.com/ruannnebornman/veldmuis"
license=("MIT")
_pkgbuild_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "${_pkgbuild_dir}/nvidia-580xx-package-set.sh"
# This package is intentionally only a metapackage. The actual NVIDIA 580xx
# binary packages are built by the package automation and published to
# veldmuis-extra; see development/nvidia-580xx-package-flow.md.
depends=(
  "dkms"
  "linux-headers"
  "${veldmuis_nvidia_580xx_runtime_packages[@]}"
)
optdepends=(
  "linux-lts: recovery kernel for legacy NVIDIA systems"
  "linux-lts-headers: headers for DKMS rebuilds on linux-lts"
)
source=(
  "nvidia-580xx-package-set.sh"
)
sha256sums=(
  "30bfa9ce5eaf7ecc345d47354f90b34e91c9d9f0f37459b5150bcc34e566a6e9"
)

package() {
  :
}
